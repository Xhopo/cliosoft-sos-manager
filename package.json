{
  "name": "cliosoft-sos-manager",
  "displayName": "ClioSoft SOS Manager",
  "description": "VSCode extension for ClioSoft SOS Manager, allowing users to view and switch file versions",
  "version": "0.0.1",
  "publisher": "xhopo",
  "author": "xhopo with trae",

  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:cliosoft-sos-manager.fileVersions"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cliosoft-sos-manager.checkout",
        "title": "Check out the current file without lock",
        "category": "ClioSoft SOS"
      },
      {
        "command": "cliosoft-sos-manager.checkin",
        "title": "Check in the current file",
        "category": "ClioSoft SOS"
      },
      {
        "command": "cliosoft-sos-manager.diff",
        "title": "Diff the current file with last version",
        "category": "ClioSoft SOS"
      },
      {
        "command": "cliosoft-sos-manager.discard",
        "title": "Discard the current file without lock",
        "category": "ClioSoft SOS"
      },
      {
        "command": "cliosoft-sos-manager.officeOpen",
        "title": "Office open the current file",
        "category": "ClioSoft SOS"
      },
      {
        "command": "cliosoft-sos-manager.compileRtl",
        "title": "Compile RTL",
        "category": "ClioSoft SOS"
      },
      {
        "command": "cliosoft-sos-manager.rebuildCtags",
        "title": "Rebuild ctags",
        "category": "ClioSoft SOS"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "cliosoft-sos-manager.checkout",
          "group": "cliosoft-sos@1",
          "when": "resourceScheme == file"
        },
        {
          "command": "cliosoft-sos-manager.checkin",
          "group": "cliosoft-sos@2",
          "when": "resourceScheme == file"
        },
        {
          "command": "cliosoft-sos-manager.diff",
          "group": "cliosoft-sos@3",
          "when": "resourceScheme == file"
        },
        {
          "command": "cliosoft-sos-manager.discard",
          "group": "cliosoft-sos@4",
          "when": "resourceScheme == file"
        },
        {
          "command": "cliosoft-sos-manager.officeOpen",
          "group": "cliosoft-sos@5",
          "when": "resourceScheme == file"
        },
        {
          "command": "cliosoft-sos-manager.compileRtl",
          "group": "cliosoft-sos@6"
        },
        {
          "command": "cliosoft-sos-manager.rebuildCtags",
          "group": "cliosoft-sos@7"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cliosoft-sos-manager",
          "title": "ClioSoft SOS"
        }
      ]
    },
    "views": {
      "cliosoft-sos-manager": [
        {
          "id": "cliosoft-sos-manager.fileVersions",
          "name": "File Versions"
        },
        {
          "id": "cliosoft-sos-manager.explorer",
          "name": "Explorer"
        }
      ]
    },
    "configuration": {
      "title": "ClioSoft SOS Manager",
      "properties": {
        "cliosoft-sos-manager.enableDebugInfo": {
          "type": "boolean",
          "default": false,
          "description": "Enable debug information output in console and status bar"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^18.11.18",
    "typescript": "^5.3.3",
    "vscode-test": "^0.4.3"
  }
}
